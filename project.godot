; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Atomic Bombs Opus 5.5"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/positional_shadow/atlas_size=8192
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/default_filters/anisotropic_filtering_level=4
shading/overrides/force_vertex_shading=false

[shader_globals]

g_blast_center={
"type": "vec3",
"value": Vector3(0, -10000, 0)
}
g_blast_age={
"type": "float",
"value": -1.0
}
g_crater={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
g_dome={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
g_scorch={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
g_scorch_color={
"type": "vec4",
"value": Vector4(0.08, 0.07, 0.06, 0)
}
g_shock={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
g_cloud_pos={
"type": "vec4",
"value": Vector4(0, -10000, 0, 0)
}
g_cloud_shape={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
g_sun_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
g_snow={
"type": "float",
"value": 0.0
}
g_water={
"type": "vec4",
"value": Vector4(0, 0, 0, -10000)
}
g_fireball={
"type": "vec4",
"value": Vector4(0, -10000, 0, 0)
}
g_fireball_color={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
g_flash={
"type": "float",
"value": 0.0
}
g_humidity={
"type": "float",
"value": 0.5
}
g_night={
"type": "float",
"value": 0.0
}
g_quality={
"type": "float",
"value": 1.0
}
g_heat_haze={
"type": "float",
"value": 0.0
}
g_fog={
"type": "vec4",
"value": Vector4(2.6e-05, 1800, 6e-06, 0)
}
g_fog_color={
"type": "vec4",
"value": Vector4(0.6, 0.65, 0.72, 1)
}
g_fog_sun={
"type": "vec4",
"value": Vector4(1, 0.9, 0.7, 0)
}
g_ambient={
"type": "vec4",
"value": Vector4(0.35, 0.45, 0.6, 1)
}
g_sun_light={
"type": "vec4",
"value": Vector4(3, 2.9, 2.8, 1)
}
g_patch={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
g_exposure={
"type": "float",
"value": 1.0
}
